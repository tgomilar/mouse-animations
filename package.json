{
  "name": "mouse-animations",
  "version": "1.0.0",
  "description": "Cursor & mouse effects library for TypeScript & JavaScript — trail, ripple, custom cursor, magnetic, particles, parallax, tilt, spotlight, flashlight, invert, image cursor. Zero dependencies, under 5 kB gzipped, optional jQuery plugin.",
  "author": "Tanja Gomilar",
  "type": "module",
  "main": "./dist/mouse-animations.cjs",
  "module": "./dist/mouse-animations.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mouse-animations.js",
      "require": "./dist/mouse-animations.cjs"
    },
    "./jquery": {
      "types": "./dist/jquery.d.ts",
      "import": "./dist/mouse-animations.jquery.js",
      "require": "./dist/mouse-animations.jquery.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite playground",
    "build": "tsc && vite build",
    "build:playground": "vite build playground --outDir ../dist-playground",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview playground"
  },
  "devDependencies": {
    "@types/jquery": "^4.0.0",
    "@types/node": "^25.5.0",
    "canvas": "^3.2.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.0",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.6"
  },
  "keywords": [
    "cursor",
    "cursor-effects",
    "cursor-animation",
    "custom-cursor",
    "image-cursor",
    "mouse",
    "mouse-effects",
    "mouse-animation",
    "trail",
    "ripple",
    "particles",
    "magnetic",
    "parallax",
    "tilt",
    "spotlight",
    "flashlight",
    "invert",
    "animation",
    "effects",
    "typescript",
    "zero-dependency",
    "jquery",
    "jquery-plugin",
    "library"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tgomilar/mouse-animations.git"
  },
  "homepage": "https://tgomilar.github.io/mouse-animations/",
  "bugs": {
    "url": "https://github.com/tgomilar/mouse-animations/issues"
  },
  "peerDependencies": {
    "jquery": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "jquery": {
      "optional": true
    }
  }
}
